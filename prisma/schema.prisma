generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model categories {
  id           String       @id @default(cuid())
  restaurantId String
  name         String
  icon         String?      @default("🍽️")
  description  String?      @default("")
  displayOrder Int          @default(0)
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  restaurants  restaurants  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menu_items   menu_items[]

  @@index([restaurantId, displayOrder])
  @@index([restaurantId, isActive])
}

model menu_items {
  id                     String        @id @default(cuid())
  restaurantId           String
  categoryId             String
  name                   String
  description            String?       @default("")
  price                  Float
  imageUrl               String?       @default("")
  isAvailable            Boolean       @default(true)
  isActive               Boolean       @default(true)
  isVeg                  Boolean       @default(true)
  isSpicy                Boolean       @default(false)
  isBestseller           Boolean       @default(false)
  preparationTimeMinutes Int           @default(15)
  displayOrder           Int           @default(0)
  createdAt              DateTime      @default(now())
  updatedAt              DateTime      @updatedAt
  categories             categories    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  restaurants            restaurants   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  order_items            order_items[]

  @@index([restaurantId, categoryId, isAvailable, isActive])
}

model order_items {
  id                  String      @id @default(cuid())
  orderId             String
  menuItemId          String?
  name                String
  price               Float
  quantity            Int         @default(1)
  specialInstructions String?     @default("")
  isVeg               Boolean     @default(true)
  menu_items          menu_items? @relation(fields: [menuItemId], references: [id])
  orders              orders      @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

model orders {
  id                 String        @id @default(cuid())
  restaurantId       String
  tableId            String?
  tableNumber        String
  subtotal           Float
  taxRate            Float         @default(5.0)
  tax                Float
  totalAmount        Float
  status             OrderStatus   @default(RECEIVED)
  customerNotes      String?       @default("")
  paymentStatus      PaymentStatus @default(PENDING)
  paymentMethod      String?       @default("CASH")
  diningSessionToken String?
  /// The bill this order was paid on
  billId             String?
  /// When a waiter tapped "Got it" on a customer's QR order. Null = nobody has looked yet.
  seenAt             DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt
  order_items        order_items[]
  restaurants        restaurants   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables             tables?       @relation(fields: [tableId], references: [id])
  bills              bills?        @relation(fields: [billId], references: [id], onDelete: SetNull)

  @@index([billId])
  @@index([diningSessionToken])
  @@index([restaurantId, createdAt])
  @@index([restaurantId, status, createdAt])
  @@index([tableId, status])
}

model restaurants {
  id               String             @id @default(cuid())
  name             String
  slug             String             @unique
  description      String?            @default("")
  logo             String?            @default("")
  bannerUrl        String?            @default("")
  address          String?            @default("")
  phone            String?            @default("")
  currency         String             @default("₹")
  taxRate          Float              @default(5.0)
  isActive         Boolean            @default(true)
  status           RestaurantStatus   @default(PENDING)
  /// Ask customers to verify their WhatsApp number on the QR menu (for e-bills and offers)
  customerOtp      CustomerOtpMode    @default(OFF)
  /// Last bill number handed out; bills are numbered 1, 2, 3… per restaurant
  billCounter      Int                @default(0)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  bills            bills[]
  customers        customers[]
  categories       categories[]
  menu_items       menu_items[]
  orders           orders[]
  tables           tables[]
  users            users[]
  service_requests service_requests[]
  table_sessions   table_sessions[]
  feedback         feedback[]
}

model tables {
  id               String             @id @default(cuid())
  restaurantId     String
  tableNumber      String
  label            String?            @default("")
  capacity         Int                @default(4)
  qrCodeToken      String             @unique @default(cuid())
  isActive         Boolean            @default(true)
  status           TableStatus        @default(AVAILABLE)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  orders           orders[]
  bills            bills[]
  service_requests service_requests[]
  table_sessions   table_sessions[]
  restaurants      restaurants        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, tableNumber])
  @@index([qrCodeToken])
  @@index([restaurantId, status, isActive])
}

model users {
  id           String       @id @default(cuid())
  restaurantId String?
  name         String
  email        String?      @unique
  /// Unique per restaurant: the same waiter can work at more than one place
  phone        String?
  password     String?
  role         UserRole     @default(WAITER)
  pinCode      String?      @default("1234")
  isActive     Boolean      @default(true)
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  restaurants  restaurants? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  bills        bills[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, pinCode, isActive])
  @@index([phone])
}

model otp_verifications {
  id        String   @id @default(cuid())
  phone     String
  otp       String
  purpose   String   @default("WAITER_AUTH")
  /// Set for customer codes requested from a table QR
  tableId   String?
  expiresAt DateTime
  attempts  Int      @default(0)
  isUsed    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([phone, purpose, isUsed])
  @@index([tableId, createdAt])
  @@index([expiresAt])
}

enum OrderStatus {
  RECEIVED
  PREPARING
  READY
  SERVED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
}

enum RestaurantStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum CustomerOtpMode {
  /// Don't ask for a number
  OFF
  /// Ask, but the customer can skip
  OPTIONAL
  /// Must verify before ordering
  REQUIRED
}

enum UserRole {
  SUPERADMIN
  ADMIN
  MANAGER
  WAITER
}

/// A customer tapping "Call waiter", "Water" or "Bring bill" on the table QR menu.
model service_requests {
  id             String               @id @default(cuid())
  restaurantId   String
  tableId        String
  tableNumber    String
  type           ServiceRequestType
  status         ServiceRequestStatus @default(OPEN)
  createdAt      DateTime             @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  restaurants    restaurants          @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables         tables               @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([restaurantId, status])
  @@index([tableId, status])
}

enum ServiceRequestType {
  CALL_WAITER
  WATER
  BILL
}

enum ServiceRequestStatus {
  OPEN
  ACKNOWLEDGED
  DONE
}

/// The one customer phone allowed to order for a table, from first order until the bill is paid.
/// The phone holds "<id>.<secret>" in an httpOnly cookie; only a hash of the secret is stored.
model table_sessions {
  id           String      @id @default(cuid())
  restaurantId String
  tableId      String
  secretHash   String
  startedAt    DateTime    @default(now())
  lastSeenAt   DateTime    @default(now())
  endedAt      DateTime?
  /// PAID, RESET (waiter freed the table for another phone) or EXPIRED
  endedReason  String?
  /// Set once the phone verifies its WhatsApp number
  customerId   String?
  restaurants  restaurants @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables       tables      @relation(fields: [tableId], references: [id], onDelete: Cascade)
  customers    customers?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  feedback     feedback?

  @@index([tableId, endedAt])
}

/// One-tap rating a customer leaves after paying.
model feedback {
  id             String         @id @default(cuid())
  restaurantId   String
  sessionId      String         @unique
  tableNumber    String
  /// 1 = bad, 2 = okay, 3 = good
  rating         Int
  comment        String?        @default("")
  createdAt      DateTime       @default(now())
  restaurants    restaurants    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table_sessions table_sessions @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([restaurantId, createdAt])
}

/// A diner who verified their WhatsApp number on the QR menu. One row per restaurant.
model customers {
  id             String           @id @default(cuid())
  restaurantId   String
  phone          String
  /// Ticked "Send me offers on WhatsApp"
  offersOptIn    Boolean          @default(false)
  createdAt      DateTime         @default(now())
  lastSeenAt     DateTime         @default(now())
  restaurants    restaurants      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table_sessions table_sessions[]
  bills          bills[]

  @@unique([restaurantId, phone])
  @@index([restaurantId, lastSeenAt])
}

/// A paid bill: every unpaid order on a table, settled together.
model bills {
  id             String      @id @default(cuid())
  restaurantId   String
  billNumber     Int
  tableId        String?
  tableNumber    String
  subtotal       Float
  tax            Float
  totalAmount    Float
  /// CASH or UPI
  paymentMethod  String
  customerId     String?
  /// Staff member who marked it paid
  staffId        String?
  whatsappSentAt DateTime?
  createdAt      DateTime    @default(now())
  orders         orders[]
  restaurants    restaurants @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  tables         tables?     @relation(fields: [tableId], references: [id], onDelete: SetNull)
  customers      customers?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  users          users?      @relation(fields: [staffId], references: [id], onDelete: SetNull)

  @@unique([restaurantId, billNumber])
  @@index([restaurantId, createdAt])
  @@index([customerId])
}
